# Environment Variables for BloodLink Backend
# Copy this file to .env and fill in your actual values

# Basic Configuration
NODE_ENV=development
PORT=3000

# Supabase Configuration (replace with your actual values)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
JWT_SECRET=your-jwt-secret-key

# Firebase Configuration (optional)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=your-firebase-client-email
# FIREBASE_PRIVATE_KEY=your-firebase-private-key

# API Keys (optional)
# ANTHROPIC_API_KEY=your-anthropic-api-key
# RESEND_API_KEY=your-resend-api-key
# MAPBOX_SECRET_TOKEN=your-mapbox-secret-token
# SENTRY_DSN=your-sentry-dsn

# BloodLink Configuration
DEFAULT_SEARCH_RADIUS_KM=25
MAX_SEARCH_RADIUS_KM=500
DONATION_COOLDOWN_DAYS=56
POINTS_PER_DONATION=100
POINTS_PER_REFERRAL=50

# Edge Functions (replace with your actual edge function URLs)
EDGE_NOTIFY_DONORS_URL=https://your-project-id.supabase.co/functions/v1/notify-donors
EDGE_AWARD_POINTS_URL=https://your-project-id.supabase.co/functions/v1/award-points
